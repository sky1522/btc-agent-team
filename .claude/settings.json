{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/data/**)",
      "Write(/data/**)",
      "Edit(/dashboard/**)",
      "Write(/dashboard/**)",
      "Bash(uv run python tools/defillama_btc.py)",
      "Bash(uv run python tools/analyze_yields.py)",
      "PowerShell(uv run python tools/defillama_btc.py)",
      "PowerShell(uv run python tools/analyze_yields.py)",
      "Bash(uv run pytest -q)",
      "Bash(uv run ruff check .)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "WebFetch(domain:yields.llama.fi)",
      "WebFetch(domain:api.llama.fi)",
      "WebFetch(domain:defillama.com)",
      "WebSearch",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(Invoke-WebRequest*)",
      "Bash(iwr*)",
      "Bash(Invoke-RestMethod*)",
      "Bash(irm*)",
      "PowerShell(curl*)",
      "PowerShell(wget*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(iwr*)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(irm*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_agent.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_agent.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_agent.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": true
  }
}
