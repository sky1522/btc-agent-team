{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/data/**)",
      "Write(/data/**)",
      "Edit(/dashboard/**)",
      "Write(/dashboard/**)",
      "Bash(uv run python tools/defillama_btc.py)",
      "Bash(uv run python tools/analyze_yields.py)",
      "Bash(uv run pytest -q)",
      "Bash(uv run ruff check .)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "WebFetch(domain:yields.llama.fi)",
      "WebFetch(domain:api.llama.fi)",
      "WebFetch(domain:defillama.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(Invoke-WebRequest*)",
      "Bash(iwr*)",
      "Bash(Invoke-RestMethod*)",
      "Bash(irm*)",
      "PowerShell(curl*)",
      "PowerShell(wget*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(iwr*)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(irm*)"
    ]
  }
}
